# =============================================================================
# SISMAWATCH ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Project & Environment
PROJECT_NAME="SismoWatch Data Lakehouse & AI Analytics Platform"
ENVIRONMENT=production
DEBUG=false

# PostgreSQL Database Configuration
HOST_POSTGRES_PORT=5433
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sismowatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_pass

# Layer-specific Database Connection Strings
# (Used by services respecting least privilege)
DATABASE_URL=postgresql+asyncpg://app_user:app_secret_pass@postgres:5432/sismowatch
INGEST_DATABASE_URL=postgresql://ingest_user:ingest_secret_pass@postgres:5432/sismowatch
TRANSFORM_DATABASE_URL=postgresql://transform_user:transform_secret_pass@postgres:5432/sismowatch

# JWT Authentication & RBAC
# Generate secure key with: openssl rand -hex 32
JWT_SECRET_KEY=sismowatch-super-secret-jwt-key-2025-production-grade
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial User Credentials (Injected at startup; never hardcoded in plaintext)
ADMIN_USER=admin@sismowatch.com
ADMIN_PASSWORD=AdminSismoWatch2025!
VIEWER_USER=viewer@sismowatch.com
VIEWER_PASSWORD=ViewerSismoWatch2025!

# Apache Airflow Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.4-python3.11
AIRFLOW_UID=50000
AIRFLOW_BASE_URL=http://airflow-webserver:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://127.0.0.1:5173

# AI & LLM Provider (Optional - falls back to deterministic template engine if empty)
OPENAI_API_KEY=
