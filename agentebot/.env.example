# Database Connection (Default: SQLite for portability; support for PostgreSQL)
DATABASE_URL=sqlite:///./seismic_agent.db
# Para PostgreSQL descomentar la siguiente línea:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/seismic_db

# USGS GeoJSON Endpoint
# Opciones disponibles:
# - Pasada hora: https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
# - Pasado día:  https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
# - Pasado mes:  https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_month.geojson
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson

# Configuración del LLM / Agente Inteligente
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Nivel de Registro (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
